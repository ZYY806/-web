# ============================================================
#  Git 忽略规则 —— 这些文件/目录不会被提交到仓库
# ============================================================

# Python 运行时缓存
__pycache__/
*.py[cod]

# 环境变量（含 API 密钥，绝对不能上传！）
.env

# 虚拟环境
venv/
.venv/

# 数据库 / 日志等本地文件
*.log
*.pid

# 游客互动数据存档（帖子/评论/留言，运行时自动生成）
data/store.json

# 操作系统杂项
.DS_Store
Thumbs.db
