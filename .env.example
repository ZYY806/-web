# ============================================================
#  环境变量模板 —— 复制本文件并改名为 .env 后按需填写
#  注意：.env 已被 .gitignore 忽略，不会上传到公开仓库
# ============================================================

# ★ 本站已不再使用任何数据库 ★
#   文旅数据全部写在 data_store.py（纯 Python，开箱即用）
#   游客的帖子/评论/留言存档在 data/store.json，重启不丢
#   因此这里不需要填写任何数据库连接信息

# 网站登录会话密钥（改为只有你自己知道的一长串随机字符）
SECRET_KEY=change-me-to-a-long-random-string

# 百度地图开放平台 AK（可选，用于 /map 地图页；申请见 https://lbsyun.baidu.com）
BAIDU_MAP_AK=

# 联系我们页展示 / 接收留言的联系邮箱
CONTACT_EMAIL=ztlsc1202@qq.com

# QQ邮箱 SMTP（用于"联系我们"真实发信）
# 授权码获取：QQ邮箱 → 设置 → 账号与安全 → 安全设置 → 开启SMTP服务，生成授权码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=你的QQ邮箱@qq.com
SMTP_PASSWORD=你的QQ邮箱授权码（不是QQ密码，切勿填写真实值到本模板）
SMTP_USE_SSL=true

# ============================================================
#  AI 智能问答（大模型）
#  不填 AI_API_KEY 也能跑：会自动降级为「站内知识库检索式回答」
# ============================================================
# 接口地址（OpenAI 兼容协议，任选其一）
#   火山方舟豆包：https://ark.cn-beijing.volces.com/api/v3
#   DeepSeek    ：https://api.deepseek.com
#   智谱 GLM    ：https://open.bigmodel.cn/api/paas/v4
#   OpenAI 官方 ：https://api.openai.com/v1  （国内直连不通、需外币卡，演示不建议）
AI_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# 你的大模型 API Key（只写在本机 .env，绝不写进代码、绝不上传仓库）
AI_API_KEY=
# 模型名称 / 方舟接入点 ID
AI_MODEL=doubao-seed-1-6-251015
# 多模态识图模型（拍照识德州 / 拍照生成路线用）。留空则与 AI_MODEL 相同（豆包 seed 1.6 自带视觉能力）
AI_VISION_MODEL=
# 单次调用超时（秒）与温度（越低越稳，问答建议 0.3~0.5）
AI_TIMEOUT=25
AI_TEMPERATURE=0.4
